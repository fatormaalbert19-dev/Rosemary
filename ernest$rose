<script>
// Particles
(function(){var c=document.getElementById('pts');for(var i=0;i<30;i++){var p=document.createElement('div');p.className='p';p.style.left=Math.random()*100+'%';p.style.animationDuration=(6+Math.random()*10)+'s';p.style.animationDelay=(Math.random()*8)+'s';var s=(1+Math.random()*3)+'px';p.style.width=s;p.style.height=s;c.appendChild(p);}})();
// Envelope
var oo=false;
function openEnv(){if(oo)return;oo=true;document.getElementById('env').classList.add('open');setTimeout(function(){document.getElementById('si').classList.add('vis');},1200);setTimeout(function(){document.getElementById('main').classList.add('vis');},1800);}
// Nav
function gto(id){document.getElementById(id).scrollIntoView({behavior:'smooth'});}
// Reveal
var ids=['hero','ann','venue','story','tl','gal','dress','rsvp','reg','cult','ty'];
var ro=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting)x.target.classList.add('on');});},{threshold:.12});
document.querySelectorAll('.rv').forEach(function(el){ro.observe(el);});
var nds=document.querySelectorAll('.nd');
var no=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){var i=ids.indexOf(x.target.id);if(i>=0){nds.forEach(function(d){d.classList.remove('on');});if(nds[i])nds[i].classList.add('on');}}}); },{threshold:.4});
ids.forEach(function(id){var el=document.getElementById(id);if(el)no.observe(el);});
// Float RSVP
window.addEventListener('scroll',function(){if(window.scrollY>window.innerHeight*.8&&oo)document.getElementById('frsvp').classList.add('vis');});
// Countdown
function tick(){var t=new Date('October 23, 2027 13:00:00').getTime()-Date.now();if(t<=0){document.querySelector('.cw').innerHTML='<div style="color:var(--gold-light);font-family:\'Great Vibes\',cursive;font-size:36px">Today is the Day!</div>';return;}var f=function(n){return String(n).padStart(2,'0');};document.getElementById('cd').textContent=Math.floor(t/86400000);document.getElementById('ch').textContent=f(Math.floor(t%86400000/3600000));document.getElementById('cm').textContent=f(Math.floor(t%3600000/60000));document.getElementById('cs2').textContent=f(Math.floor(t%60000/1000));}
tick();setInterval(tick,1000);
// Music
var mon=false;function toggleMusic(){var a=document.getElementById('bgm');if(!a.src||a.src===location.href){alert('Add an audio URL to the <audio> element to enable background music.');return;}if(mon){a.pause();mon=false;}else{a.play().catch(function(){});mon=true;}}
// RSVP
function subRsvp(e){e.preventDefault();document.getElementById('rform').style.display='none';document.getElementById('rsuc').style.display='block';}
// Lightbox
function olb(){document.getElementById('lb').classList.add('on');document.body.style.overflow='hidden';}
function clb(){document.getElementById('lb').classList.remove('on');document.body.style.overflow='';}
document.getElementById('lb').addEventListener('click',function(e){if(e.target===this)clb();});
document.addEventListener('keydown',function(e){if(e.key==='Escape')clb();});
</script>
